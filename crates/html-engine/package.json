{
  "name": "@openlen/html-engine",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "types": "index.d.ts",
  "description": "Rust-backed HTML engine for OpenLen — round-trip + ID-tag ops + normalize chain + sanitize + minify + streaming.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/orbita-pos/openlen.git",
    "directory": "crates/html-engine"
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "napi": {
    "name": "openlen-html-engine",
    "npmClient": "npm",
    "triples": {
      "defaults": false,
      "additional": [
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu"
      ]
    }
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test:rust": "cargo test",
    "test:node": "node --test __test__/*.test.mjs",
    "prepublishOnly": "napi prepublish -t npm --skip-gh-release"
  },
  "optionalDependencies": {
    "@openlen/html-engine-win32-x64-msvc": "0.1.0",
    "@openlen/html-engine-linux-x64-gnu": "0.1.0"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0"
  },
  "engines": {
    "node": ">= 18"
  }
}
