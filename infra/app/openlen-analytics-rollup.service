[Unit]
Description=OpenLen — daily analytics rollup + 90d retention
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=openlen-deploy
Group=www-data

# SAME secrets file as openlen-app.service (/etc/openlen/openlen.env, 640
# root:openlen-deploy, populated by install-app.sh) — DATABASE_URL etc.
WorkingDirectory=/opt/openlen-app
EnvironmentFile=/etc/openlen/openlen.env

ExecStart=/usr/bin/npm run analytics:rollup

StandardOutput=journal
StandardError=journal
SyslogIdentifier=openlen-rollup

# Same defensive posture as the backup service. Needs DB network access
# but no filesystem writes outside its own logs.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
