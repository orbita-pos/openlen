# /etc/openlen/openlen.env — runtime secrets and config for openlen-app.service.
#
# Copy this file to /etc/openlen/openlen.env on the box and fill in the
# values. install-app.sh creates an empty template on first run and sets
# perms to 640 root:openlen-deploy so only the systemd User= can read.
#
# Restart the service after editing:
#   systemctl restart openlen-app

# ──────────────────────────────────────────────────────────────────────────────
# AI — Fireworks writes the pages, OpenAI edits images
# ──────────────────────────────────────────────────────────────────────────────

# REQUIRED. The only credential generation needs: both writing roles travel
# over Fireworks — DeepSeek for the HTML, Qwen when the turn carries an
# attached image. Without it Create / Chat / the Agent return 500 BEFORE
# opening the stream, naming this variable (lib/ai/turn-credentials.ts).
#   https://fireworks.ai/account/api-keys
FIREWORKS_API_KEY=

# Only for instruction-based image EDITING — the Replace modal and the
# Agent's `editar_imagen` tool, both on gpt-image-2. Without it that one
# feature returns 503 `ai_unavailable` and nothing else notices.
# OpenAI's API is PREPAID: an empty balance produces the same 503, and the
# GPT Image models may need the org verified in the developer console.
#   https://platform.openai.com/api-keys
OPENAI_API_KEY=

# LEN 2.5 (2026-10). The terminal: Len's `bash` (just-bash over the project's
# own files, no processes, disk or network; lib/agent/terminal/). ON BY
# DEFAULT, as in DeepSeek's harness (N45, 2026-10-03): only the literal "0"
# turns it off, and then Len works with Read/Edit/Write/Grep/Glob only, as in
# 2.1 — and can't see the saved versions, which only live in `bash`.
OPENLEN_TERMINAL=

# THE REAL TERMINAL (2026-10-21, lib/agent/sandbox/, infra/SANDBOX_RUNBOOK.md):
# with an E2B key, Len's `bash` runs in an isolated E2B box per project (node,
# python3 with pip, network only to npm, PyPI and GitHub); the files go in and
# out through Write's guards and today's terminal is the fallback. Billed per
# second to the owner's credits at E2B's list price. Without the key, today's.
#   https://console.e2b.dev (Keys tab)
E2B_API_KEY=
# OPENLEN_SANDBOX=0                         # off at once, even with the key (the reaper still cleans up)
# OPENLEN_SANDBOX_DAILY_USD=5               # OpenLen's cap on all E2B spend per UTC day; over it, today's terminal
# OPENLEN_SANDBOX_ONLY_USERS=               # comma-separated user ids: only they get the box (the first days)

# Len's web_search / web_fetch (lib/agent/web/). Without it they return a
# readable error and nothing else breaks. ~$0.015 per query; Len charges
# 1.5 credits per query.
#   https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# PARKED — do NOT set (2026-10-03, a1af8745): OPENLEN_DYNAMIS=1 offers
# «Len Odyssey» (lib/agent/dynamis.ts) in every chat. It lost to Len 2.5 on
# the hard game; it stays in the code for the bench only.

# NOT USED ANY MORE — do not set them, nothing reads them (2026-08-28/29):
#   GEMINI_API_KEY    Gemini left the repo; every surface runs on Fireworks.
#   TOGETHER_API_KEY  legacy, dead for far longer.
#   MOCK_MODE         the mock dispatcher it gated no longer exists.

# Canonical domain — used in <link rel="canonical">, OG/Twitter cards, and
# schema.org JSON-LD on generated landings.
OPENLEN_DOMAIN=openlen.com

# Optional inariwatch error monitoring DSN. Leave blank for stdout-only mode.
INARIWATCH_DSN=

# ──────────────────────────────────────────────────────────────────────────────
# Auth (Postgres + Auth.js)
# ──────────────────────────────────────────────────────────────────────────────

# Postgres connection string. Self-host (co-located on the box):
#   postgresql://openlen:***@127.0.0.1:5432/openlen
# Driver is node-postgres (pg) over the standard wire protocol — it also accepts
# a Neon standard string (append ?sslmode=require) during the migration window.
DATABASE_URL=

# El backend de las páginas (lib/backend, infra/PAGES_BACKEND_RUNBOOK.md): el
# clúster APARTE donde vive una base por proyecto. Las dos las escribe
# infra/db/setup-pages-cluster.sh. Sin ellas /rest/v1 y /auth/v1 contestan 503.
#   PAGES_DATABASE_URL — el administrador del clúster (no superusuario):
#     postgresql://openlen_pages_admin:***@127.0.0.1:5433/postgres
#   PAGES_AUTHENTICATOR_PASSWORD — el rol `authenticator` (sólo [A-Za-z0-9]).
PAGES_DATABASE_URL=
PAGES_AUTHENTICATOR_PASSWORD=

# Sign cookie secret. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Public URL the app is served from. Used by Auth.js for callbacks.
NEXTAUTH_URL=https://openlen.com

# Optional OAuth provider (login) — Google is the only one.
#
# ⚠️ NO pongas GITHUB_ID / GITHUB_SECRET. Entrar con GitHub se construyo y se
# QUITO despues (`dc6f8083`): `auth.ts` cablea Credentials + Google y nada mas,
# y el formulario pinta un solo boton. Las dos llaves sobrevivieron al borrado y
# siguieron en la caja hasta el 2026-08-29 pareciendo configuracion viva.
#
# NO CONFUNDIR con GITHUB_DEPLOY_CLIENT_ID / _SECRET, mas abajo: esas SI se leen
# — son las del boton «Push to GitHub» del taller, que es otra cosa.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Deploy-dropdown export targets (Vercel + GitHub) ──────────────────────────
# Power the workspace "Deploy to Vercel" / "Push to GitHub" buttons. These are
# OPERATOR-level OAuth client credentials; each end user connects their OWN
# account at runtime (one click) and their token is stored encrypted per-user.
# When unset, the dropdown buttons show but report "not available yet".
#
# GitHub: register an OAuth App (Settings → Developer settings → OAuth Apps).
#   Callback URL: ${NEXTAUTH_URL}/api/integrations/github/callback
GITHUB_DEPLOY_CLIENT_ID=
GITHUB_DEPLOY_CLIENT_SECRET=
#
# GitHub App «OpenLen» (spec local 2026-10-28-ficheros-al-nivel-de-claude-code, §9): what git push/pull and `gh`
# use, «Conectar GitHub» in Publicar → Exportar. Registered by Jesús on 2026-10-28 (slug `openlen`, Any account,
# no webhook, OAuth during installation, callback ${NEXTAUTH_URL}/api/integrations/github-app/callback; Contents,
# Pull requests and Issues read/write, Checks and Commit statuses read, Repository creation write; and the
# Organization permission Members: read, without which an organization can't be connected — only its admins may).
# The private key is the .pem in BASE64 on one line: base64 -w0 key.pem. All five, or GitHub stays off.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
#
# Vercel: create a connectable-account integration (Integrations Console).
#   Redirect URL:  ${NEXTAUTH_URL}/api/integrations/vercel/callback
#   API scopes:    deployments (read/write) + projects (read/write)
#   The slug is the integration's URL slug (vercel.com/integrations/<slug>).
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
VERCEL_INTEGRATION_SLUG=

# ── Billing — Polar (Merchant of Record) for the paid "Pro" tier ──────────────
# Polar is the legal seller / MoR: it runs checkout, invoices the customer, and
# collects + remits VAT/sales tax. OpenLen never handles a card or issues a
# customer factura. When unset, the in-app "Upgrade" link reports "not
# available yet"; the webhook returns 500.
#
#   1. polar.sh → Settings → create an Organization Access Token.
#   2. Create a "Pro" recurring product; copy its Product ID.
#   3. Add a webhook → ${NEXTAUTH_URL}/api/billing/webhook (format: Raw); copy
#      its signing secret.
# Defaults to Polar SANDBOX — set POLAR_SERVER=production to take real payments.
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_PRO_ID=
# El producto de Max ($20/mes). Sin él, «Pásate a Max» falla en vez de vender Pro.
POLAR_PRODUCT_MAX_ID=
# El producto de Ultra ($99.99/mes). Sin él, «Pásate a Ultra» falla igual.
POLAR_PRODUCT_ULTRA_ID=
POLAR_WEBHOOK_SECRET=

# Resend (password-reset emails). Without it the reset link is logged to
# journalctl for manual copy-paste during emergencies.
RESEND_API_KEY=
EMAIL_FROM=OpenLen <no-reply@openlen.com>

# Broadcast (member email campaigns). CAN-SPAM requires a physical postal
# address in every marketing email — the send route REFUSES with 503 until
# this is set. Use a real mailing address or PO box.
BROADCAST_POSTAL_ADDRESS=

# ──────────────────────────────────────────────────────────────────────────────
# Internal machine-to-machine routes (localhost only, never public)
# ──────────────────────────────────────────────────────────────────────────────

# Guards the internal routes POST /api/internal/republish and
# /api/internal/republish-templates. Compared with crypto.timingSafeEqual;
# unset here means they ALWAYS 401 (fail-closed). (It was born for the
# live-data hourly refresh, retired in Len 2.1.)
# Generate with: openssl rand -base64 32
OPENLEN_INTERNAL_SECRET=

# ──────────────────────────────────────────────────────────────────────────────
# Uploads — filesystem mode (default for self-host)
# ──────────────────────────────────────────────────────────────────────────────

# Both of these are also set in openlen-app.service Environment= lines as
# defaults. Override here only if you want a different path.
# UPLOADS_DIR=/var/openlen/uploads
# UPLOADS_PUBLIC_URL=/uploads
# WITNESS_DIR=/var/openlen/witness

# Cloudflare R2 alternative — set all three to switch from filesystem to R2.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_BUCKET=openlen-uploads
# R2_PUBLIC_URL=https://uploads.openlen.com

# ──────────────────────────────────────────────────────────────────────────────
# Cloudflare cache purge for published landings
# ──────────────────────────────────────────────────────────────────────────────
#
# Required when `*.<PUBLISH_BASE_HOST>` is proxied (orange cloud). Without
# these, publish still works but CF will serve stale HTML for up to s-maxage
# after a new deploy. The zone is the one of PUBLISH_BASE_HOST (openlen.app in
# production, NOT openlen.com: with the wrong zone the purge "succeeds" and
# clears nothing). Token needs Zone:Zone:Read + Zone:Cache Purge:Edit on it.
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=

# ──────────────────────────────────────────────────────────────────────────────
# R2 backup of published release HTML
# ──────────────────────────────────────────────────────────────────────────────
#
# Separate bucket from R2_BUCKET (uploads). Reuses R2_ACCOUNT_ID /
# R2_ACCESS_KEY / R2_SECRET_KEY above. Without R2_PUBLISHED_BUCKET set,
# the per-publish backup is a no-op (the nightly rclone sync in
# infra/scripts/backup-published-to-r2.sh still works independently).
# R2_PUBLISHED_BUCKET=openlen-published

# ──────────────────────────────────────────────────────────────────────────────
# Edge Functions (infra/FUNCTIONS_RUNBOOK.md)
# ──────────────────────────────────────────────────────────────────────────────
#
# Without OPENLEN_FUNCTIONS_ENGINE nothing runs: /functions/v1 answers 503 and
# Len doesn't offer them. Production runs on Cloudflare Workers for Platforms
# (`cloudflare`, with the five OPENLEN_CF_* below); `local` is for development
# only (it runs third-party code inside the app process).
# OPENLEN_FUNCTIONS_ENGINE=
# OPENLEN_FUNCTIONS=0                      # turns every function off at once
# OPENLEN_CF_ACCOUNT_ID=
# OPENLEN_CF_API_TOKEN=                    # "Workers Scripts: Edit" only
# OPENLEN_CF_NAMESPACE=openlen-functions
# OPENLEN_CF_DISPATCH_URL=                 # printed by npm run functions:cloudflare-setup
# OPENLEN_CF_DISPATCH_KEY=                 # openssl rand -hex 32
# OPENLEN_FUNCTIONS_CAP_FREE_USD=1         # monthly cap of the free pool, list price, all allowed CPU per call
# OPENLEN_FUNCTIONS_CAP_PAID_USD=25
# OPENLEN_FUNCTIONS_ALERT_EMAIL=           # 80% pool alert; defaults to ABUSE_REPORT_EMAIL
# The AI of the apps (lib/app-ai, spec local 2026-10-15): /ai/v1/chat/completions,
# called by a project's Edge Functions. On whenever the Edge Functions are on.
# OPENLEN_APP_AI=0                          # turns it off at once (503 app_ai_disabled)
# OPENLEN_APP_AI_FREE_DAILY_USD=2           # all free-plan apps together, per UTC day
# Stripe with the owner's own account (lib/stripe, spec local 2026-10-21): the key check,
# the `stripe` command, the copy to live mode when publishing and the Payments tab.
# On whenever the Edge Functions are on.
# OPENLEN_STRIPE=0                          # turns all of it off (what is published keeps charging)
# La revisión de seguridad al publicar (lib/security-review, spec local 2026-10-15).
# OPENLEN_SECURITY_REVIEW=0 la apaga entera (también las reglas sin modelo).
# OPENLEN_SECURITY_REVIEW=
# Lo que OpenLen gasta al día en revisiones con modelo, en dólares (por defecto 5).
# OPENLEN_SECURITY_REVIEW_DAILY_USD=5
