[Unit]
Description=OpenLen — notification queue drainer
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=openlen-deploy
Group=www-data

WorkingDirectory=/opt/openlen-app
EnvironmentFile=/etc/openlen/openlen.env

ExecStart=/usr/bin/node /opt/openlen-app/cron/notifications-drain.mjs

StandardOutput=journal
StandardError=journal
SyslogIdentifier=openlen-notifications-drain

# Needs DB + FCM/APNS network access but no filesystem writes outside its logs.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
