[Unit]
Description=OpenLen — project email domains check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=openlen-deploy
Group=www-data

WorkingDirectory=/opt/openlen-app
EnvironmentFile=/etc/openlen/openlen.env

ExecStart=/usr/bin/node /opt/openlen-app/cron/email-domains-check.mjs

StandardOutput=journal
StandardError=journal
SyslogIdentifier=openlen-email-domains

# Needs DB + Resend's API, no filesystem writes outside its logs.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
