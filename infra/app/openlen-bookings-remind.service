[Unit]
Description=OpenLen — booking reminders + retention sweep
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=openlen-deploy
Group=www-data

# SAME secrets file as openlen-app.service (/etc/openlen/openlen.env, 640
# root:openlen-deploy, populated by install-app.sh) — DATABASE_URL etc. Needs
# RESEND_API_KEY + EMAIL_FROM set to actually send reminder emails.
WorkingDirectory=/opt/openlen-app
EnvironmentFile=/etc/openlen/openlen.env

ExecStart=/usr/bin/npm run bookings:remind

StandardOutput=journal
StandardError=journal
SyslogIdentifier=openlen-bookings-remind

# Needs DB + Resend network access but no filesystem writes outside its logs.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
