[Unit]
Description=OpenLen — nightly system backup to R2 (uploads + DB dump + /etc/openlen + manifest)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Runs as root — UNLIKE the pages backup (openlen-deploy). This one tars
# /etc/openlen, which holds files owned by other roots/groups (e.g. edge.env
# is 640 root:openlen-edge; openlen.env is root:root). openlen-deploy can't
# read those, so tar would exit non-zero and sink the whole /etc upload. Root
# reads them all, and the archive is encrypted before it leaves the box.
User=root

Environment=RCLONE_CONF=/etc/openlen/rclone.conf

# Installed out-of-band to a deploy-independent path (Gate B / DR_RUNBOOK):
# /opt/openlen-app is wiped by every atomic-swap deploy, so the backup scripts
# live under /opt/openlen-backup instead.
ExecStart=/bin/bash /opt/openlen-backup/backup-system-to-r2.sh

StandardOutput=journal
StandardError=journal
SyslogIdentifier=openlen-backup-system

# Defensive — same posture as openlen-backup.service. pg_dump + tar write
# only to the private /tmp; nothing under /var is written.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
# El "-" es load-bearing: sin él, un box sin dir de uploads mata el unit en el
# setup del namespace ANTES de correr el script — que ya maneja ese caso con
# un skip. El backup de DB/etc/manifiesto debe correr igual.
ReadOnlyPaths=-/var/openlen/uploads
