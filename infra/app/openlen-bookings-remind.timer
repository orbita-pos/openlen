[Unit]
Description=OpenLen — booking reminder timer
Requires=openlen-bookings-remind.service

[Timer]
# Every 15 minutes. A 24h-before reminder needs sub-hour granularity (a booking
# made 23h ahead must still get reminded), so a daily timer is too coarse. The
# retention sweep inside the script self-gates to ~04:xx UTC so the destructive
# pass runs once/day, not 96×. Persistent=true catches up a missed window.
OnCalendar=*:0/15
Persistent=true
RandomizedDelaySec=2m

[Install]
WantedBy=timers.target
