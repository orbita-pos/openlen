[Unit]
Description=OpenLen — system backup timer (DB dump + /etc + manifest), every 4h
Requires=openlen-backup-system.service

[Timer]
# Every 4h at :47 UTC (00,04,08,12,16,20) — shrinks the DB data-loss window
# from ~24h to ~4h. :47 keeps it clear of the published-pages backup (03:17).
# The dump name is date-only, so each run REFRESHES today's artifact (no
# storage growth); prune still keeps 7 daily snapshots. Persistent catches up
# a run missed during downtime.
OnCalendar=*-*-* 00/4:47:00
Persistent=true
RandomizedDelaySec=5m

[Install]
WantedBy=timers.target
