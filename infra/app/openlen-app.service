[Unit]
Description=OpenLen Next.js application
After=network.target caddy.service
Wants=network-online.target

# EL LÍMITE DE ARRANQUES ESTÁ DESACTIVADO A PROPÓSITO.
#
# Con un límite, tres fallos seguidos dejan la unidad en `failed` y el sitio
# CAÍDO hasta que una persona lo levante. En un solo nodo y sin nadie de
# guardia, eso convierte un fallo transitorio de 30 segundos —Postgres que se
# reinicia, un pico de memoria— en horas de caída a las cuatro de la mañana.
#
# Sin límite reintenta siempre, que es lo que hace Kubernetes por omisión
# (CrashLoopBackOff no se rinde nunca) y por el mismo motivo: la asimetría.
# Rendirse no arregla nada permanente y sí alarga lo transitorio.
#
# El precio de no rendirse es el martilleo: `openlen-edge` se reinició 61.676
# veces cada 5 s entre el 2026-07-28 y el 2026-08-01. Eso lo paga el backoff
# de abajo, no el límite.
StartLimitIntervalSec=0

[Service]
Type=simple
User=openlen-deploy
Group=www-data
WorkingDirectory=/opt/openlen-app

# Bind to localhost only — the web tier (Caddy today, openlen-edge after
# cutover) is the only thing that should reach the Node process. 0.0.0.0
# here would be reachable from the public internet despite ufw, since the
# web tier isn't in the path.
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1

# Persistent data dirs survive deploys (the atomic swap in deploy.ps1 only
# replaces /opt/openlen-app, not /var/openlen). Filesystem storage writes to
# UPLOADS_DIR; witness records write to WITNESS_DIR.
Environment=UPLOADS_DIR=/var/openlen/uploads
Environment=UPLOADS_PUBLIC_URL=/uploads
Environment=WITNESS_DIR=/var/openlen/witness

# Session 11 — per-user subdomain hosting. The publish flow writes one
# directory per claimed subdomain to PUBLISH_ROOT; the web tier serves it.
# The wildcard site block reads from the same root. PUBLISH_BASE_HOST is
# the bare host that subdomains are stitched onto when building URLs.
Environment=PUBLISH_ROOT=/var/www/openlen
Environment=PUBLISH_BASE_HOST=openlen.com

# Puppeteer reaches Chrome through this binary path (installed by
# setup-node.sh via apt). Without this the gates module hunts in
# ~/.cache/puppeteer which doesn't exist for a system user.
Environment=PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Secrets (FIREWORKS_API_KEY, DATABASE_URL, NEXTAUTH_SECRET, etc.) live in
# /etc/openlen/openlen.env. install-app.sh sets perms to 640 root:openlen-deploy
# so the systemd User= can read but other users can't.
EnvironmentFile=/etc/openlen/openlen.env

ExecStart=/usr/bin/node /opt/openlen-app/server.js

# Reintento con freno: 5s, y va subiendo hasta 60s como mucho.
#
# `RestartSteps` + `RestartMaxDelaySec` piden systemd 254; el box corre 255.
# Sin ellos el reintento es cada 5 s para siempre, que es lo que produjo los
# 61.676 arranques del edge en 3 días y 18 horas. Con el freno, ese mismo
# bucle habrían sido unos pocos miles y sin morder la CPU.
#
# El límite de arranques vive en [Unit] y está desactivado a propósito — ver
# allí. Estuvo en [Service] hasta el 2026-08-24 y systemd lo ignoraba en
# silencio desde v230, así que la unidad decía 60s y aplicaba 10.
Restart=on-failure
RestartSec=5s
RestartSteps=5
RestartMaxDelaySec=60s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=openlen-app

# Memory bounding. The publish/create paths now spawn headless Chrome to
# render project-card thumbnails (lib/projects/thumbnail.ts, capped at
# OPENLEN_THUMBNAIL_CONCURRENCY=1 by default). On the 4 GB CX22 a render storm
# could otherwise let the kernel OOM-killer reap the Node process.
# MemoryHigh is a SOFT cap: past it the cgroup is throttled + reclaimed under
# pressure (slows down, never killed); it leaves headroom for the OS + Caddy.
# Tune up if the app legitimately needs more.
#
# 🔴 Y AHORA TAMBIÉN UN TOPE DURO, 2026-09-03. Aquí ponía «no hard MemoryMax —
# we prefer slow over a hard kill», y esa preferencia SIGUE SIENDO la correcta:
# por eso el duro va MUY por encima del suave, para que no lo sustituya. Lo que
# cambió son los hechos que sostenían dejarlo abierto:
#
#   1. La línea de arriba decía «with no swap». MEDIDO hoy: hay 4 GB de swap y
#      sólo 51 MB usados. Con swap, el freno suave ya tiene a dónde reclamar,
#      así que el duro deja de ser «matar en vez de ir lento» y pasa a ser
#      «matar sólo cuando ya no queda nada que reclamar».
#   2. El Agente abre un Chromium POR TURNO desde hoy (medirDelTurno en
#      app/api/agent/route.ts). MEDIDO: 525 MB tras un render, 604 MB tras dos.
#      Ya no es una miniatura ocasional: son medio giga por turno concurrente.
#
# LA CUENTA, con lo medido en la caja (3.819 MB totales):
#   pico real del servicio hoy ............ 1.415 MB
#   + un navegador por turno .............. ~600 MB
#   otros (caddy 43 + postgres + fail2ban
#   + sistema) ............................ ~400 MB
#   → 3,4 G deja ~400 MB al resto y sólo se alcanza con VARIOS turnos a la vez.
#
# POR QUÉ UN KILL ES MEJOR QUE EL OOM DEL KERNEL, que es la pregunta de verdad:
# el kernel elige a la víctima por heurística y puede llevarse POSTGRES, que no
# se levanta solo y se lleva el sitio entero con él. El tope de la unidad acota
# el daño a NUESTRO proceso, y este servicio ya sabe resucitar — Restart=
# on-failure con backoff, arriba. Un fallo acotado y que se cura solo gana a una
# ruleta que puede tocarle a la base de datos.
MemoryAccounting=true
MemoryHigh=3G
MemoryMax=3400M

# Security hardening. ProtectSystem=full keeps /usr, /boot, /etc read-only;
# ReadWritePaths re-opens just the dirs the app needs to write.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/openlen /var/www/openlen

[Install]
WantedBy=multi-user.target
