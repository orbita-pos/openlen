# /etc/openlen/edge.env — runtime config for openlen-edge.service.
#
# Copy this file to /etc/openlen/edge.env on the box and fill the values that
# don't have a working default for production. install.sh sets the perms to
# 640 root:openlen-edge so only the systemd User= can read it.
#
# Restart the service after editing:
#   systemctl restart openlen-edge
#
# Every var listed has a safe default in crates/edge/src/config.rs — most can
# stay commented unless you need to tune. The required-for-prod set is just
# OPENLEN_EDGE_DATABASE_URL (for custom domains) + OPENLEN_EDGE_ACME_CONTACT
# (to enable on-demand TLS issuance).

# ──────────────────────────────────────────────────────────────────────────────
# Listener
# ──────────────────────────────────────────────────────────────────────────────

# TLS listener bind address. Default `0.0.0.0:443`. During the bake-off
# phase of the cutover (see infra/edge/CUTOVER.md step 4d) bind to a non-
# production port like `0.0.0.0:8443` so the edge runs side-by-side with
# Caddy without fighting for ports.
# OPENLEN_EDGE_BIND=0.0.0.0:443

# HTTP listener for the cleartext → HTTPS redirect + ACME HTTP-01 challenge
# responder. Default `0.0.0.0:80`. Set to `off` to disable (useful while
# Caddy still owns :80 during the bake-off).
# OPENLEN_EDGE_BIND_HTTP=0.0.0.0:80

# Cap on simultaneous in-flight TLS handshakes / requests. Drops new
# connections at the accept loop when reached — surfaces in metrics as
# openlen_edge_handshake_capped_total. Default 4096.
# OPENLEN_EDGE_MAX_INFLIGHT=4096

# ──────────────────────────────────────────────────────────────────────────────
# TLS — wildcard cert
# ──────────────────────────────────────────────────────────────────────────────

# Path to the certbot-managed wildcard cert + key. The defaults match the
# layout that the existing certbot deploy maintains. The watcher reloads
# the cert in-memory on every rotation (no service restart).
# OPENLEN_EDGE_CERT=/etc/letsencrypt/live/openlen.com/fullchain.pem
# OPENLEN_EDGE_KEY=/etc/letsencrypt/live/openlen.com/privkey.pem

# ──────────────────────────────────────────────────────────────────────────────
# Static file roots
# ──────────────────────────────────────────────────────────────────────────────

# Per-subdomain publish root. Each `<sub>` has `<root>/<sub>/current/` (the
# rotating release symlink) + `<root>/<sub>/assets/` (assets that survive
# rotations). The edge serves `*.openlen.com` traffic from here.
# OPENLEN_EDGE_PUBLISH_ROOT=/var/www/openlen

# Shared user-uploads root. Served direct from disk for any host whose URL
# starts with `/uploads/`. Mirrors UPLOADS_DIR in openlen-app.service.
# OPENLEN_EDGE_UPLOADS_ROOT=/var/openlen/uploads

# Next.js build-time static assets. Served direct on apex/www hosts when
# the URL starts with `/_next/static/`. Matches the `cp .next/static` step
# in infra/scripts/deploy.ps1.
# OPENLEN_EDGE_NEXT_STATIC_ROOT=/opt/openlen-app/.next/static

# ──────────────────────────────────────────────────────────────────────────────
# Proxy — Node upstream
# ──────────────────────────────────────────────────────────────────────────────

# Upstream Next.js URL. The edge keeps an HTTP/1.1 pool against it for any
# request that isn't apex/static/custom-disk.
# OPENLEN_EDGE_NODE_URL=http://127.0.0.1:3000

# Hosts that proxy unconditionally to Node — the apex + www. CSV.
# OPENLEN_EDGE_PROXY_HOSTS=openlen.com,www.openlen.com

# Path prefixes proxied to Node on wildcard subdomain hosts. /c/ = analytics
# beacons, /api/f/ = lead-capture form submissions. Both are public/
# anonymous endpoints; the broader /api/* surface stays off-limits to
# user-deployed subdomains.
# OPENLEN_EDGE_PROXY_PATHS=/c/,/api/f/

# Path prefixes proxied to Node on custom-domain hosts. Wider than the
# wildcard set because a custom domain aliases a single project — exposing
# /api/* is fine (most endpoints 401 anyway, the public ones keep working).
# OPENLEN_EDGE_CUSTOM_DOMAIN_PROXY_PATHS=/c/,/api/

# Hard end-to-end timeout on upstream requests, including TCP connect +
# header read + body. Set high enough to cover /api/generate's worst-case
# Together call (~30s averaged, 90s p99) without breaking SSE.
# OPENLEN_EDGE_NODE_TIMEOUT_SECS=30

# Per-frame idle window between upstream body frames. 0 disables the timer
# (body streams forever once headers arrive). Default 60s is generous for
# SSE keep-alives (Next sends a ping every ~30s) while still capping a
# hostile upstream that hangs the body.
# OPENLEN_EDGE_PROXY_BODY_IDLE_TIMEOUT_SECS=60

# ──────────────────────────────────────────────────────────────────────────────
# Custom-domain lookup — Postgres
# ──────────────────────────────────────────────────────────────────────────────

# Postgres connection string for the `customDomains` table. REQUIRED in
# production — without it the edge runs with an empty in-memory mock and
# custom domains 404. Use the same DATABASE_URL the app uses (self-hosted on
# the box), scoped to a read-only role if you're paranoid (the edge only
# SELECTs).
OPENLEN_EDGE_DATABASE_URL=

# Connection pool ceiling. Default 8 — fine for the bench profile.
# OPENLEN_EDGE_DB_POOL_MAX=8

# Domain-cache tuning. Default TTLs (60s positive + 60s negative) keep
# verification-status changes propagating within a minute; default cap of
# 10k entries comfortably covers the verified-domain population.
# OPENLEN_EDGE_DOMAIN_CACHE_TTL_SECS=60
# OPENLEN_EDGE_DOMAIN_NEGATIVE_TTL_SECS=60
# OPENLEN_EDGE_DOMAIN_CACHE_MAX=10000

# Cap on simultaneous SWR background revalidations. 0 = inherit
# OPENLEN_EDGE_DB_POOL_MAX so a wave of cached entries crossing TTL/2 at
# the same wall clock can't fan out to N concurrent Postgres queries.
# OPENLEN_EDGE_DOMAIN_REVAL_CONCURRENCY=0

# Loopback-only internal API for tooling that wants to drive the lookup
# (e.g. cache-purge from the app). `off` disables; otherwise a loopback
# bind like `127.0.0.1:3081`.
# OPENLEN_EDGE_INTERNAL_API_BIND=off

# ──────────────────────────────────────────────────────────────────────────────
# Custom-domain TLS — on-demand ACME
# ──────────────────────────────────────────────────────────────────────────────

# Contact mailbox passed to Let's Encrypt during account registration.
# REQUIRED for on-demand TLS issuance to work — without it (or with an
# empty value) the resolver refuses to issue and custom-domain TLS
# handshakes fail with a clean "unrecognised name" alert.
OPENLEN_EDGE_ACME_CONTACT=ops@openlen.com

# Master switch — set to `false` to disable issuance even when contact is
# set (cert hot-reload still works; pre-loaded certs from CERT_DIR are
# still served). Defaults to `true` whenever ACME_CONTACT is set.
# OPENLEN_EDGE_ACME_ENABLED=true

# ACME directory URL. Use the staging endpoint for tests / dry-runs.
# OPENLEN_EDGE_ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
# OPENLEN_EDGE_ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory

# Persistent cert state. The renewal sweep + on-demand issuance both write
# under here (one sub-dir per domain). Must be writable by the systemd
# User=openlen-edge (install.sh creates it with mode 700 and the right
# ownership). The systemd unit also adds ReadWritePaths=/var/lib/openlen-edge.
# OPENLEN_EDGE_CERT_DIR=/var/lib/openlen-edge/certs

# Renew custom-domain certs when less than this many days of validity
# remain. The sweep wakes every interval (default 24h) and walks CERT_DIR.
# OPENLEN_EDGE_CERT_RENEWAL_THRESHOLD_DAYS=30
# OPENLEN_EDGE_CERT_RENEWAL_INTERVAL_SECS=86400

# ──────────────────────────────────────────────────────────────────────────────
# Observability
# ──────────────────────────────────────────────────────────────────────────────

# Prometheus exporter bind. Default loopback-only — a node-local Prometheus
# sidecar scrapes here. Set to `off` to disable, or to `0.0.0.0:9090`
# behind a firewall rule for an external scraper. The endpoint is
# unauthenticated.
# OPENLEN_EDGE_METRICS_BIND=127.0.0.1:9090

# Tracing filter — same syntax as RUST_LOG. Default `info,openlen_edge=info`.
# Bump openlen_edge to `debug` during the bake-off + the first 24h of
# soak so route-decision + cert-issuance traces land in journald.
RUST_LOG=info,openlen_edge=info

# Log format — `pretty` for tail-friendly dev output, `json` for prod
# (journald + machine-parseable). Default `json`.
OPENLEN_EDGE_LOG_FORMAT=json

# ──────────────────────────────────────────────────────────────────────────────
# IP rate limiter (F4 S2)
# ──────────────────────────────────────────────────────────────────────────────
#
# Defense-in-depth layer in front of Node — per-IP burst + sustained caps
# that drop 429 BEFORE the request can spend Node CPU / DB connections /
# auth lookups. Coexists with the Node-side per-userId quotas (those still
# enforce plan limits; the edge layer just stops abusive traffic earlier).
#
# Default OFF. Activate gradually after the cutover soak — see
# infra/edge/CUTOVER.md §10 ("Activating rate-limit post-cutover").
#
# Telemetry surfaces:
#   openlen_edge_rate_limit_decisions_total{result}    (exempt/allowed/blocked/error)
#   openlen_edge_rate_limit_decision_duration_seconds  (histogram, sub-ms)
#   openlen_edge_rate_limit_memory_hits_total{source}  (per IP source label)
#   openlen_edge_rate_limit_pg_hits_total              (always 0 — memory-only)

# Master switch. When false (default), no SmartCache is constructed, no
# layer touches the router — zero perf impact.
# OPENLEN_EDGE_RATE_LIMIT_ENABLED=false

# Per-IP burst cap (60-second token bucket). 300 ≈ 5 rps sustained burst
# — sits comfortably above well-behaved bot traffic; flags abuse quickly.
# OPENLEN_EDGE_RATE_LIMIT_PER_IP_PER_MIN=300

# Per-IP sustained cap (1-hour token bucket). 5000 ≈ 1.4 rps over an
# hour — enough headroom for shared NAT (hotel WiFi, small office) while
# still capping single-IP scrapers.
# OPENLEN_EDGE_RATE_LIMIT_PER_IP_PER_HOUR=5000

# Path prefixes that bypass the limiter entirely. /c/ analytics beacons
# are already rate-limited Node-side and would dominate the bucket;
# ACME HTTP-01 challenges MUST NOT be blocked or cert issuance fails.
# OPENLEN_EDGE_RATE_LIMIT_EXEMPT_PATHS=/c/,/.well-known/acme-challenge/

# TCP peer IPs trusted to forward proxy headers (cf-connecting-ip,
# x-real-ip). Empty = trust all peers — fine for the current single-
# Cloudflare-edge posture. Restrict to Cloudflare's IP ranges
# (https://www.cloudflare.com/ips-v4 + ips-v6) if the edge ever sits
# behind a less-trusted proxy chain. CSV of IPv4 / IPv6 literals.
# OPENLEN_EDGE_RATE_LIMIT_TRUSTED_PROXIES=
