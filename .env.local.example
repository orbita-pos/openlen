# ──────────────────────────────────────────────────────────────────────────────
# Required
# ──────────────────────────────────────────────────────────────────────────────

# Together AI — required for real (non-mock) generations. Get one at
# https://api.together.ai. Free trial credit usually covers the eval suite.
TOGETHER_API_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# Generation
# ──────────────────────────────────────────────────────────────────────────────

# Set to "1" to use mock responses (zero API spend). Pipeline still records
# witness + costs, just against the canned mock dispatcher in lib/together/mock.ts.
# MOCK_MODE=1

# Canonical domain for generated landings — used in <link rel="canonical">,
# OG / Twitter card URLs, and schema.org JSON-LD. Leave unset to omit; the
# generated HTML still works (just without absolute self-references).
# OPENLEN_DOMAIN=openlen.com

# Optional: inariwatch error monitoring DSN. Leave blank for local dev
# (auto-detected). https://inariwatch.com
INARIWATCH_DSN=

# ──────────────────────────────────────────────────────────────────────────────
# Auth (Neon Postgres + Auth.js)
# ──────────────────────────────────────────────────────────────────────────────

# Neon Postgres connection string (pooled is fine).
# Get yours at https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Auth.js — used to sign session cookies. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# GitHub OAuth (optional — email+password works without it)
# Register at https://github.com/settings/developers
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# Google OAuth (optional)
# Register at https://console.cloud.google.com/apis/credentials → OAuth client (Web)
#   Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend for password-reset emails (optional — without it the reset link is
# logged to the server console so you can copy-paste it during dev).
# https://resend.com
RESEND_API_KEY=
EMAIL_FROM=OpenLen <no-reply@yourdomain.com>

# ──────────────────────────────────────────────────────────────────────────────
# Uploads (Session 9 image-upload feature)
# ──────────────────────────────────────────────────────────────────────────────

# Filesystem storage (default — used when R2_* below are unset). The endpoint
# writes files under UPLOADS_DIR and serves them at UPLOADS_PUBLIC_URL.
# UPLOADS_DIR=./public/uploads
# UPLOADS_PUBLIC_URL=/uploads

# Cloudflare R2 (optional). If all three credential vars are set the upload
# endpoint switches from filesystem to R2 automatically. The R2 adapter
# lazy-imports @aws-sdk/client-s3 — install it before enabling:
#   npm install @aws-sdk/client-s3
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_BUCKET=openlen-uploads
# R2_PUBLIC_URL=https://uploads.openlen.com
