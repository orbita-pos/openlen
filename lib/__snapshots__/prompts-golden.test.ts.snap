    key = "ja" if KANA.search(text) else "ko" if HANGUL.search(text) else "zh" if HAN.search(text) else "latin"
    name = "Place_" + key
    if name not in pdfmetrics.getRegisteredFontNames():
        path = FONT_FILES[key]
        pdfmetrics.registerFont(TTFont(name, path, subfontIndex=0) if path.endswith(".ttc") else TTFont(name, path))
    return name


def shown_size(page):
    """The page's width and height as it is shown: swapped when it is turned 90° or 270°."""
    w, h = float(page.mediabox.width), float(page.mediabox.height)
    return (h, w) if page.rotation % 180 else (w, h)


def read_fields(path, reader):
    try:
        with open(path, encoding="utf-8") as f:
            spec = json.load(f)
    except (OSError, ValueError) as e:
        fail(1, f"Cannot read {path}: {e}")
    if not isinstance(spec, dict) or not isinstance(spec.get("fields"), list) or not spec["fields"]:
        fail(1, f'{path} must be {{"fields": [{{"page", "box", "text"}}]}}.')
    images = {}
    for image in spec.get("images") or []:
        try:
            images[int(image["page"])] = (float(image["width"]), float(image["height"]))
        except (KeyError, TypeError, ValueError):
            fail(1, f'Each entry of "images" needs "page", "width" and "height": {image!r}')
    fields, errors = [], []
    for n, field in enumerate(spec["fields"], start=1):
        try:
            page = int(field["page"])
            box = [float(v) for v in field["box"]]
            text = str(field["text"])
            size = float(field.get("size", 10))
        except (KeyError, TypeError, ValueError):
            errors.append(f'field {n} needs "page", "box" ([x0, top, x1, bottom]) and "text": {field!r}')
            continue
        if not 1 <= page <= len(reader.pages):
            errors.append(f"field {n}: page {page} does not exist (the PDF has {len(reader.pages)})")
            continue
        if len(box) != 4 or box[0] >= box[2] or box[1] >= box[3] or not text or size <= 0:
            errors.append(f"field {n}: box must be [x0, top, x1, bottom] with x0 < x1 and top < bottom, and text not empty")
            continue
        if page in images:
            shown_w, shown_h = shown_size(reader.pages[page - 1])
            sx, sy = shown_w / images[page][0], shown_h / images[page][1]
            box = [box[0] * sx, box[1] * sy, box[2] * sx, box[3] * sy]
        fields.append({"n": n, "page": page, "box": box, "text": text, "size": size})
    return fields, errors


def check(fields):
    errors = []
    for i, a in enumerate(fields):
        width, height = a["box"][2] - a["box"][0], a["box"][3] - a["box"][1]
        needed = pdfmetrics.stringWidth(a["text"], font_for(a["text"]), a["size"])
        if a["size"] > height or needed > width:
            errors.append(f"field {a['n']}: {a['text']!r} at size {a['size']:g} needs {needed:.0f} x {a['size']:g} pt and its box is {width:.0f} x {height:.0f}: make the box bigger or the size smaller")
        for b in fields[i + 1:]:
            if a["page"] == b["page"] and a["box"][0] < b["box"][2] and b["box"][0] < a["box"][2] and a["box"][1] < b["box"][3] and b["box"][1] < a["box"][3]:
                errors.append(f"fields {a['n']} and {b['n']} overlap on page {a['page']}")
    return errors


def stamp(reader, fields):
    writer = PdfWriter(clone_from=reader)
    for number in sorted({f["page"] for f in fields}):
        page = reader.pages[number - 1]
        media = page.mediabox
        left, bottom_edge = float(media.left), float(media.bottom)
        width, height = float(media.width), float(media.height)
        shown_height = shown_size(page)[1]
        buffer = io.BytesIO()
        c = canvas.Canvas(buffer, pagesize=(width, height))
        c.transform(*TURN[page.rotation % 360](width, height))
        for f in (f for f in fields if f["page"] == number):
            x0, top, _x1, bottom = f["box"]
            c.setFont(font_for(f["text"]), f["size"])
            baseline = shown_height - bottom + (bottom - top - f["size"]) / 2 + f["size"] * 0.2
            c.drawString(x0 + 1, baseline, f["text"])
        c.save()
        overlay = PdfReader(io.BytesIO(buffer.getvalue())).pages[0]
        if left or bottom_edge:
            overlay.add_transformation([1, 0, 0, 1, left, bottom_edge])
        writer.pages[number - 1].merge_page(overlay)
    return writer


def main():
    if len(sys.argv) != 4:
        fail(1, "Usage: python3 place_text.py <in.pdf> <fields.json> <out.pdf>")
    source, fields_path, target = sys.argv[1:]
    if os.path.abspath(source) == os.path.abspath(target):
        fail(1, "Write the filled form to a new file, not over the original.")
    reader = open_pdf(source)
    fields, errors = read_fields(fields_path, reader)
    errors += check(fields)
    if errors:
        fail(1, "\\n".join(errors))
    writer = stamp(reader, fields)
    try:
        with open(target, "wb") as f:
            writer.write(f)
    except Exception:
        if os.path.exists(target):
            os.remove(target)
        raise
    print(f"placed {len(fields)} texts -> {target}")


if __name__ == "__main__":
    main()
"
`;

exports[`golden de los prompts de producción > manual de la plataforma (/.openlen/skills/skill-creator/SKILL.md) — la salida entera, sin cambios accidentales 1`] = `
"---
name: skill-creator
description: Create or edit a skill of this project or of the person — when the user asks to save a way of working, a recurring process or procedure (how they quote, how they write their weekly promo), or says "make it a skill".
---

# Creating a skill

A skill is a set of instructions that loads only when a task needs it: the catalog shows its name and description every turn, and its body is read when the task matches. Use one for a procedure that applies to some requests (how to quote, how to answer a complaint, how to prepare the weekly promo). Rules that must apply to EVERY message go in \`/LEN.md\` (the project's) or \`~/.len/LEN.md\` (the person's), not in a skill.

## Where it goes

- \`/.len/skills/<name>/SKILL.md\` — the project's: shared with everyone who works on this project. The default.
- \`~/.len/skills/<name>/SKILL.md\` — the person's own: only for them, in every project. Use it when they say it is theirs ("my way", "for me").

Write it with \`Write\` (or \`Edit\` to change one). A user skill is only its SKILL.md: no scripts or other files next to it. \`/.openlen/skills\` holds OpenLen's own skills, read-only, and their names are reserved.

## What it looks like

\`\`\`markdown
---
name: cotizar
description: How this bakery quotes cakes and delivery. Use it whenever the user asks for a price or a quote.
---

# Quoting

- A one-tier cake: 350.
- …
\`\`\`

- \`name\`: lowercase words joined by "-", the same as its folder.
- \`description\`: one line saying what it does AND when to use it — it is all the catalog shows, so it decides whether the skill loads.
- Optional: \`when_to_use: <more on when>\`; \`disable-model-invocation: true\` so only the user can invoke it with \`/<name>\`; \`user-invocable: false\` to keep it out of the user's \`/\` menu.

Write the body as instructions to yourself: the facts and numbers the user gave, the steps in order, and a worked example when there are calculations. Never invent figures the user didn't give; ask them. No credentials in a skill.

## After writing it

It is in the catalog from the next message, and the user can invoke it with \`/<name>\`. Tell them its name and what it will be used for. If the same rules were in \`/LEN.md\`, take them out of there so they live in one place.
"
`;

