exports[`golden de los prompts de producción > manual de la plataforma (/.openlen/skills/office-recalculate/scripts/recalc.py) — la salida entera, sin cambios accidentales 1`] = `
"#!/usr/bin/env python3
"""Recalculate every formula of a workbook with LibreOffice and save the result to a new file.

Usage: python3 recalc.py <input.xlsx> <output.xlsx> [timeout_seconds]
Prints one JSON object:
  {"ok": bool, "formulas": int, "errors": [{"cell": "Sheet!B4", "value": "#REF!"}]}
or, when nothing could be recalculated, {"ok": false, "error": "..."}.

LibreOffice runs headless with a profile of its own, driven through its Python bridge (python3-uno):
it loads the workbook, calculates all of it, and saves it as Excel 2007+.
"""
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time

ERROR_VALUES = {"#REF!", "#NAME?", "#VALUE!", "#DIV/0!", "#N/A", "#NUM!", "#NULL!"}


def fail(message):
    print(json.dumps({"ok": False, "error": message}, ensure_ascii=False))
    sys.exit(1)


def file_url(path):
    import uno

    return uno.systemPathToFileUrl(os.path.abspath(path))


def prop(name, value):
    from com.sun.star.beans import PropertyValue

    p = PropertyValue()
    p.Name = name
    p.Value = value
    return p


def recalculate(source, target, timeout):
    try:
        import uno
        from com.sun.star.connection import NoConnectException
    except ImportError:
        fail("LibreOffice's Python bridge (python3-uno) is not installed in this terminal")
    if not shutil.which("soffice"):
        fail("LibreOffice (soffice) is not installed in this terminal")
    profile = tempfile.mkdtemp(prefix="lo-profile-", dir="/tmp")
    pipe = f"recalc{os.getpid()}"
    office = subprocess.Popen(
        [
            "soffice", "--headless", "--invisible", "--nologo", "--norestore", "--nodefault",
            f"-env:UserInstallation=file://{profile}",
            f"--accept=pipe,name={pipe};urp;StarOffice.ComponentContext",
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    try:
        local = uno.getComponentContext()
        resolver = local.ServiceManager.createInstanceWithContext("com.sun.star.bridge.UnoUrlResolver", local)
        deadline = time.time() + timeout
        while True:
            try:
                ctx = resolver.resolve(f"uno:pipe,name={pipe};urp;StarOffice.ComponentContext")
                break
            except NoConnectException:
                if time.time() > deadline or office.poll() is not None:
                    fail("LibreOffice did not start in time")
                time.sleep(0.3)
        desktop = ctx.ServiceManager.createInstanceWithContext("com.sun.star.frame.Desktop", ctx)
        doc = desktop.loadComponentFromURL(file_url(source), "_blank", 0, (prop("Hidden", True),))
        if doc is None:
            fail(f"LibreOffice could not open {source}")
        try:
            doc.calculateAll()
            doc.storeToURL(file_url(target), (prop("FilterName", "Calc MS Excel 2007 XML"),))
        finally:
            doc.close(True)
    finally:
        office.terminate()
        try:
            office.wait(10)
        except subprocess.TimeoutExpired:
            office.kill()
        shutil.rmtree(profile, ignore_errors=True)


def scan(target):
    from openpyxl import load_workbook

    formulas = 0
    with_formulas = load_workbook(target, data_only=False)
    for sheet in with_formulas.worksheets:
        for row in sheet.iter_rows():
            formulas += sum(1 for c in row if isinstance(c.value, str) and c.value.startswith("="))
    errors = []
    values = load_workbook(target, data_only=True)
    for sheet in values.worksheets:
        for row in sheet.iter_rows():
            for c in row:
                if isinstance(c.value, str) and c.value in ERROR_VALUES:
                    errors.append({"cell": f"{sheet.title}!{c.coordinate}", "value": c.value})
    return formulas, errors


if __name__ == "__main__":
    if len(sys.argv) not in (3, 4):
        fail("usage: recalc.py <input.xlsx> <output.xlsx> [timeout_seconds]")
    source, target = sys.argv[1], sys.argv[2]
    if not os.path.isfile(source):
        fail(f"{source} does not exist")
    if os.path.abspath(source) == os.path.abspath(target):
        fail("write the recalculated workbook to a new file")
    recalculate(source, target, float(sys.argv[3]) if len(sys.argv) == 4 else 60.0)
    formulas, errors = scan(target)
    print(json.dumps({"ok": not errors, "formulas": formulas, "errors": errors}, ensure_ascii=False))
    sys.exit(0 if not errors else 1)
"
`;

exports[`golden de los prompts de producción > manual de la plataforma (/.openlen/skills/office-recalculate/scripts/recalc.py, en una app) — la salida entera, sin cambios accidentales 1`] = `
"#!/usr/bin/env python3
"""Recalculate every formula of a workbook with LibreOffice and save the result to a new file.

Usage: python3 recalc.py <input.xlsx> <output.xlsx> [timeout_seconds]
Prints one JSON object:
  {"ok": bool, "formulas": int, "errors": [{"cell": "Sheet!B4", "value": "#REF!"}]}
or, when nothing could be recalculated, {"ok": false, "error": "..."}.

LibreOffice runs headless with a profile of its own, driven through its Python bridge (python3-uno):
it loads the workbook, calculates all of it, and saves it as Excel 2007+.
"""
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time

ERROR_VALUES = {"#REF!", "#NAME?", "#VALUE!", "#DIV/0!", "#N/A", "#NUM!", "#NULL!"}


def fail(message):
    print(json.dumps({"ok": False, "error": message}, ensure_ascii=False))
    sys.exit(1)


def file_url(path):
    import uno

    return uno.systemPathToFileUrl(os.path.abspath(path))


def prop(name, value):
    from com.sun.star.beans import PropertyValue

    p = PropertyValue()
    p.Name = name
    p.Value = value
    return p


def recalculate(source, target, timeout):
    try:
        import uno
        from com.sun.star.connection import NoConnectException
    except ImportError:
        fail("LibreOffice's Python bridge (python3-uno) is not installed in this terminal")
    if not shutil.which("soffice"):
        fail("LibreOffice (soffice) is not installed in this terminal")
    profile = tempfile.mkdtemp(prefix="lo-profile-", dir="/tmp")
    pipe = f"recalc{os.getpid()}"
    office = subprocess.Popen(
        [
            "soffice", "--headless", "--invisible", "--nologo", "--norestore", "--nodefault",
            f"-env:UserInstallation=file://{profile}",
            f"--accept=pipe,name={pipe};urp;StarOffice.ComponentContext",
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    try:
        local = uno.getComponentContext()
        resolver = local.ServiceManager.createInstanceWithContext("com.sun.star.bridge.UnoUrlResolver", local)
        deadline = time.time() + timeout
        while True:
            try:
                ctx = resolver.resolve(f"uno:pipe,name={pipe};urp;StarOffice.ComponentContext")
                break
            except NoConnectException:
                if time.time() > deadline or office.poll() is not None:
                    fail("LibreOffice did not start in time")
                time.sleep(0.3)
        desktop = ctx.ServiceManager.createInstanceWithContext("com.sun.star.frame.Desktop", ctx)
        doc = desktop.loadComponentFromURL(file_url(source), "_blank", 0, (prop("Hidden", True),))
        if doc is None:
            fail(f"LibreOffice could not open {source}")
        try:
            doc.calculateAll()
            doc.storeToURL(file_url(target), (prop("FilterName", "Calc MS Excel 2007 XML"),))
        finally:
            doc.close(True)
    finally:
        office.terminate()
        try:
            office.wait(10)
        except subprocess.TimeoutExpired:
            office.kill()
        shutil.rmtree(profile, ignore_errors=True)


def scan(target):
    from openpyxl import load_workbook

    formulas = 0
    with_formulas = load_workbook(target, data_only=False)
    for sheet in with_formulas.worksheets:
        for row in sheet.iter_rows():
            formulas += sum(1 for c in row if isinstance(c.value, str) and c.value.startswith("="))
    errors = []
    values = load_workbook(target, data_only=True)
    for sheet in values.worksheets:
        for row in sheet.iter_rows():
            for c in row:
                if isinstance(c.value, str) and c.value in ERROR_VALUES:
                    errors.append({"cell": f"{sheet.title}!{c.coordinate}", "value": c.value})
    return formulas, errors


if __name__ == "__main__":
    if len(sys.argv) not in (3, 4):
        fail("usage: recalc.py <input.xlsx> <output.xlsx> [timeout_seconds]")
    source, target = sys.argv[1], sys.argv[2]
    if not os.path.isfile(source):
        fail(f"{source} does not exist")
    if os.path.abspath(source) == os.path.abspath(target):
        fail("write the recalculated workbook to a new file")
    recalculate(source, target, float(sys.argv[3]) if len(sys.argv) == 4 else 60.0)
    formulas, errors = scan(target)
    print(json.dumps({"ok": not errors, "formulas": formulas, "errors": errors}, ensure_ascii=False))
    sys.exit(0 if not errors else 1)
"
`;

exports[`golden de los prompts de producción > manual de la plataforma (/.openlen/skills/office-render/SKILL.md) — la salida entera, sin cambios accidentales 1`] = `
"---
name: office-render
description: Render requested document images or inspect visual layout with LibreOffice.
---

# Document images and visual inspection

Use LibreOffice through the terminal: convert the saved file to PDF, then read the PDF's pages as images with \`Read\` and its \`pages\` parameter. Do not install a replacement renderer or build an alternative rendering pipeline to work around a failed render.

## Render the saved deliverable

Keep the saved deliverable in \`/tmp/office\`. For inspection-only previews, create a new directory for each render (\`preview=$(mktemp -d /tmp/office/render.XXXXXXXX)\`) and convert into it. Quote each input and output path. Remove only that directory once image inspection finishes, including after a failed render.

\`\`\`text
soffice --headless --convert-to pdf --outdir "$preview" "<final-file>"
\`\`\`

The PDF takes the source file's name with \`.pdf\`. Read it with \`Read\` and \`pages\` ("1-3"; at most 20 pages per call): the pages come back as images. For requested image exports, convert the PDF pages to PNG with \`pdftoppm -png -r 110 "<file.pdf>" "<output-prefix>"\` in the requested directory and keep the images.

For DOCX, PPTX, or PDF, read the requested pages or slides in one call. Inspect all pages only for a requested whole-document review. A worksheet renders by its print settings, so its page numbers are not sheet numbers; change print areas or scaling only when the user requests print layout. Inspect the final saved file, reuse existing images for an unchanged source, and rerender only after requested source changes.

Check clipping, alignment, headings, table widths, contrast, chart labels, and number formats as relevant to the task. A successful command or image read alone does not establish a usable preview; guessed text geometry does not establish overflow.

## Failed or blank previews

For populated content, a fully transparent or uniformly blank image is a renderer failure. Check once and do not reread the same image. Stop visual checks for the task immediately after a blank result: do not render or read images again, even after editing or copying the source, or try another page, sheet, resolution, output format, or print setting. Preserve the usable source and requested outputs and finish applicable content and data checks.

If content and structure checks pass, name the saved file and verified edits as needed, then say in one sentence, in the user's language, that content and structure checks passed and visual inspection was not completed. Do not describe the image or pixels. Report content or structure failures separately; never say all checks passed or claim visual verification.

LibreOffice output can differ from Word, PowerPoint, or Excel. Images do not certify animation or media playback, refresh formula caches in the source workbook, or guarantee native application fidelity. Deliver requested files through \`present\`. Do not deliver inspection images or reports unless requested.
"
`;

