{
  "name": "openlen",
  "version": "0.1.0",
  "private": false,
  "license": "AGPL-3.0-only",
  "description": "Open-source landing page generator with smart multi-model routing on Together AI.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "eval": "tsx --env-file=.env.local --tsconfig tsconfig.eval.json evals/run.ts",
    "templates:seed": "tsx --env-file=.env.local --tsconfig tsconfig.eval.json scripts/templates-seed.ts",
    "templates:add": "tsx --env-file=.env.local --tsconfig tsconfig.eval.json scripts/templates-add.ts",
    "templates:republish": "tsx --env-file=.env.local --tsconfig tsconfig.eval.json scripts/templates-republish.ts",
    "templates:count": "tsx --env-file=.env.local --tsconfig tsconfig.eval.json scripts/count-templates.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push --force",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.2",
    "@aws-sdk/client-s3": "^3.1049.0",
    "@axe-core/puppeteer": "^4.11.3",
    "@inariwatch/capture": "^0.14.0",
    "@neondatabase/serverless": "^1.1.0",
    "@projectwallace/css-analyzer": "^9.8.1",
    "@projectwallace/css-design-tokens": "^0.11.4",
    "apcach": "^0.6.4",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "drizzle-orm": "^0.45.2",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "next": "^15.5.0",
    "next-auth": "^5.0.0-beta.31",
    "node-vibrant": "^4.0.4",
    "puppeteer": "^25.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.12.3",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "together-ai": "^0.21.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/culori": "^4.0.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.0",
    "lighthouse": "^13.3.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.0",
    "typescript": "^5.7.2"
  }
}
