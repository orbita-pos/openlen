# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# Playwright run artifacts (the committed visual baseline lives under
# tests/e2e/*-snapshots/ and IS tracked; these are per-run scratch only).
/test-results/
/playwright-report/
/blob-report/
/.playwright/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep .env.local.example checked in)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# witness recordings — generated artifacts, never commit
/recordings/

# uploaded images (filesystem storage adapter) — user-supplied artifacts,
# never commit. Per-deploy persistence comes from Docker volume / R2.
/public/uploads/
/uploads/

# IDE
.vscode/
.idea/

# local tooling
.claude/

# Style Match test artifacts (screenshots + computed-styles JSON dumps)
.style-match-test/
.puppeteer-cache/

# Lighthouse audit JSON outputs (generated by scripts/run-lighthouse.mjs)
lighthouse-*.json

# F1 shadow-soak JSONL output (scripts/soak/run.ts writes here; never commit
# — these are local runtime captures merged with prod logs for cutover review).
soak-log*.jsonl

# Theme-engine verification — Playwright run artifacts (npm run verify)
/scripts/verify/screenshots/
/_verify_inspect_page.html

# Local-filesystem fallback for template object storage (used when no R2
# credentials are configured). Seeded files re-uploaded on demand.
public/template-objects/

# "Imagenes by OpenLen" — WebP variants live in R2 (or the local FS fallback
# when no R2 creds); only manifest.json is committed. process.ts regenerates.
public/openlen-images/*.webp

# "By OpenLen Motion" — transcoded loops + posters live in R2 (FS fallback
# under public/openlen-images/motion/ in dev); only the manifest is committed,
# and only with R2 URLs (run openlen-motion:process with R2_* set before deploy).
public/openlen-images/motion/

# Internal dev docs — eval reports, session notes, planning + research
# drafts. Working artifacts; not for the public open-source repo.
/EVAL_*.md
/SESSION_*.md
/WORKSPACE_*.md
/BLOCKS_PROMPTS.md
/PRESETS_PROMPTS.md
/RESEARCH_FINDINGS.md
/V3_AUDIT.md
/INARI_DESIGN_ENGINE.md
/docs/SHOW_HN_DRAFT.md
# superpowers specs/plans + one-off briefs — internal planning, kept local only
/docs/superpowers/
/plans/
/docs/claude-video-showcase-brief.md
# AI template-generation prompts + design/image briefs — competitive method, local only
/docs/claude-*-prompts.md
/docs/*-design-brief.md
/docs/*-image-prompts.md
/docs/*-art-prompts.md
# Rust dev session handoffs + soak logs — internal noise, local only
/docs/rust-*-handoff.md
/docs/rust-f1-soak-*.md
# Benchmark / cutover tooling + sample dumps — local only
/bench/
# Draft / unfinished templates — local only
/templates/draft/
/templates-draft/
/templates/drafts/
# Leftover SOURCE copies of templates ALREADY registered in the DB gallery (R2).
# The 3 seeded starter HTMLs (mirror/manuscript/counter) + manifest.ts stay tracked;
# every other *.html dropped here is an already-"metido" template's local copy —
# NOT pending registration. Ignored so the dirty tree doesn't look like ~149 un-added templates.
/templates/starter/*.html
!/templates/starter/mirror.html
!/templates/starter/manuscript.html
!/templates/starter/counter.html
*.tar.gz
/tests/visual/corpus/templates/
/tests/visual/corpus/sections/
/tests/visual/corpus/*.css
/tests/visual/corpus/*passmap*.json

# Scratch / regenerable working dirs — kept on disk, not in the repo.
# .photo-export = photo-migration revert net (regen via `templates:export`).
# spike = Phase-0 assembly experiments.
/.worktrees/
/.photo-export/
/.photo-batch*/
/spike/

# scratch/ ENTERO. Antes se ignoraban cinco subcarpetas sueltas, asi que todo
# lo que caia en la raiz de scratch/ quedaba a un `git add -A` de publicarse —
# y este repo es PUBLICO (AGPL v3). Medido el 2026-08-22: 739 ficheros sin
# versionar ahi dentro (sondas, paginas generadas, respuestas del modelo,
# capturas). Ninguno es codigo del producto; los que si lo fueran no viven en
# una carpeta llamada "scratch".
#
# Los dos ficheros que YA estaban versionados (hero-backdrop-fixed.mjs,
# sanitize-damage-probe.mts) siguen rastreados: .gitignore no desrastrea nada.
# Si algun dia estorban, `git rm --cached` es una decision aparte.
/scratch/

# Tematica art workbench (originals archive + smoke screenshots — local only)
.tematicas-art/
.tematica-smoke/

# Live canary evidence: accounting artifacts, never committed.
scratch/creative-sandbox/

# Directorio de build para verificar sin pisar el dev (OPENLEN_DIST_DIR).
.next-verify/

# Volcados de crash de las herramientas de Git Bash/Cygwin.
*.stackdump

# Volcados de la base ANTES de un borrado irreversible. DATO DE USUARIO y el
# repo es publico: nunca se commitean.
/backups/

# Los PNG originales de designs/fotografo. Son fotos de 1024x1536 guardadas sin
# perdida —el peor formato posible para fotografia— y pesaban 66,6 MB frente a
# 5,7 MB de los mismos webp a q90: doce veces mas, para siempre y en cada clon.
# Las paginas usan los .webp; los .png se quedan en el disco de Jesus como
# original por si alguna vez hace falta re-exportar.
designs/fotografo/**/*.png
